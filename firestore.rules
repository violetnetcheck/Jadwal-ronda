rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token != null && request.auth.token.email == 'programmerdevelop24@gmail.com')
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Real-Time Online Presence Collection
    match /presence/{sessionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Schedules Collection (Malam Ini & Malam Besok)
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Chat Messages Collection
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Stories Collection
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Panic Alarms & Emergency
    match /panic_alarms/{alarmId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Attendance & Patrol
    match /attendances/{attId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /patrol_logs/{logId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Shift Swaps
    match /shift_swaps/{swapId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Announcements
    match /announcements/{annId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Guest Book
    match /guests/{guestId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Finances & Kas
    match /finances/{finId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
